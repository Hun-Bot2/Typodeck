          "color": "#364A50"
        },
        {
          "id": "body2",
          "role": "body",
          "content": "More than half of the public in these countries chose the alternative in the middle. Perhaps they assumed that literacy would not be so high as 80%, nor so low as 40%. This clearly shows that the public is completely unaware about the current state of the world.",
          "x": 1,
          "y": 3.6,
          "w": 11.7,
          "h": 0.75,
          "fontSize": 12.5,
