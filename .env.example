# Typodeck — environment template. Copy to `.env` (gitignored) and fill in.
# Everything runs WITHOUT any of these set: the deterministic fallback builds
# decks offline and labels them `generated_by=fallback`. Set keys only to
# enable the live model provider or authenticated GitHub access.

# Meta Muse provider (BOTH required to activate; otherwise fallback is used).
# Endpoint is user-configured; see docs/MUSE_PROVIDER.md. Never verified live
# in this repo — every demo/CLI run to date uses the fallback.
TYPOdeck_MUSE_ENDPOINT=
TYPOdeck_MUSE_API_KEY=
# Optional model override for the Muse provider (default is provider-defined).
TYPOdeck_MUSE_MODEL=

# Optional: GitHub personal access token (classic or fine-grained, public-repo
# read is enough). Only used when passed explicitly, e.g.
#   node packages/core/dist/scripts/eval.js fixtures --token-env GITHUB_TOKEN
# Without it, repo ingestion and fixture pinning run unauthenticated and are
# subject to the public rate limit (60 req/hour/IP).
GITHUB_TOKEN=
